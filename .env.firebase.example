# Firebase Configuration (from Firebase Console)
# These are safe to commit (public config)

# Get these from: Firebase Console → Project Settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase Emulator (for development only)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
# Set to true if you're running Firebase Emulator Suite locally

# Service Account Key (SENSITIVE - NEVER COMMIT)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate Private Key
# Save as a file and reference the path:
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/firebase-service-account.json

# (Optional) Keep Supabase for fallback/migration
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
