# Claude Agent Teams Configuration
# Copy this file to .env.agents.local and fill in your values

# ========================
# API Configuration
# ========================
ANTHROPIC_API_KEY=your-api-key-here

# ========================
# Model Selection
# ========================
# Options: opus-5-5, sonnet-5-5, haiku-5-5

# Backend Agent - Best for complex architecture and design
BACKEND_AGENT_MODEL=opus-5-5

# Frontend Agent - Good balance for UI/UX work
FRONTEND_AGENT_MODEL=sonnet-5-5

# Database Agent - Balanced for schema and query optimization
DATABASE_AGENT_MODEL=sonnet-5-5

# DevOps Agent - Fast for deployment and monitoring
DEVOPS_AGENT_MODEL=haiku-5-5

# ========================
# Memory Settings
# ========================
# Session memory directory (relative to project root)
MEMORY_DIR=.claude/memory

# Enable memory persistence
ENABLE_MEMORY_PERSISTENCE=true

# Auto-cleanup old memories after X days
MEMORY_RETENTION_DAYS=30

# ========================
# Agent Settings
# ========================
# Temperature for all agents (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
AGENT_TEMPERATURE=0.2

# Max tokens for agent responses
AGENT_MAX_TOKENS=2048

# Enable agent conversation history
ENABLE_CONVERSATION_HISTORY=true

# ========================
# Logging & Debugging
# ========================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed agent logs
DEBUG_AGENTS=false

# Save agent interactions to file
LOG_AGENT_INTERACTIONS=false
