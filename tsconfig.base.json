{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@ops-hub/contracts": ["./packages/contracts/src/index.ts"],
      "@ops-hub/db": ["./packages/db/src/index.ts"],
      "@ops-hub/domain": ["./packages/domain/src/index.ts"],
      "@ops-hub/events": ["./packages/events/src/index.ts"],
      "@ops-hub/integrations": ["./packages/integrations/src/index.ts"],
      "@ops-hub/shared": ["./packages/shared/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
