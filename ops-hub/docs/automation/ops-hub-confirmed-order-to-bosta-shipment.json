{
  "name": "Ops Hub confirmed order -> Bosta shipment",
  "nodes": [
    {
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {}
    },
    {
      "name": "List confirmed orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "{{$env.OPS_HUB_URL}}/v1/orders?status=confirmed",
        "options": {}
      }
    },
    {
      "name": "Create shipment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "{{$env.OPS_HUB_URL}}/v1/shipments",
        "options": {}
      }
    }
  ],
  "connections": {}
}
