# Reverse Engineering Analysis Configuration

# Target URL
TARGET_URL=https://operix.co/new-landing

# Playwright Configuration
HEADLESS=false
SLOW_MO=500
TIMEOUT=30000

# Analysis Features
SAVE_SCREENSHOTS=true
RECORD_VIDEO=true
SAVE_TRACES=true
EXTRACT_APIS=true
EXTRACT_DOM=true
EXTRACT_FORMS=true
EXTRACT_TOKENS=true

# Optional: Proxy Configuration
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: Browser Configuration
BROWSER_TYPE=chromium
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Optional: Email Configuration (for implementation phase)
SENDGRID_API_KEY=
RESEND_API_KEY=

# Optional: Analytics (for implementation phase)
NEXT_PUBLIC_GA_ID=

# Optional: Supabase (for implementation phase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Environment
NODE_ENV=development
