{
  "name": "operix-erp",
  "version": "1.0.0",
  "description": "Production-ready e-commerce ERP system with Next.js 14 + Supabase",
  "license": "MIT",
  "author": "Ahmed Taha <pccyborg.12@gmail.com>",
  "keywords": [
    "erp",
    "e-commerce",
    "next.js",
    "supabase",
    "postgresql",
    "inventory",
    "orders",
    "dashboard"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:local": "jest --testPathPattern=local",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:full": "npm run type-check && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "@supabase/auth-helpers-nextjs": "^0.7.4",
    "typescript": "^5.3.0",
    "zod": "^3.22.0",
    "recharts": "^2.10.0",
    "tailwindcss": "^3.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.294.0",
    "framer-motion": "^10.16.0",
    "axios": "^1.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.2.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.1.0",
    "playwright": "^1.40.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
