{
  "name": "ops-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Ops Hub — multi-tenant e-commerce operations platform",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "RUN_DB_TESTS=1 vitest run",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @ops-hub/api dev",
    "db:ping": "tsx packages/db/src/ping.ts",
    "db:generate": "pnpm --filter @ops-hub/db generate",
    "db:migrate": "pnpm --filter @ops-hub/db migrate",
    "db:reset": "pnpm --filter @ops-hub/db reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@ops-hub/contracts": "workspace:*",
    "@ops-hub/db": "workspace:*",
    "@ops-hub/domain": "workspace:*",
    "@ops-hub/events": "workspace:*",
    "@ops-hub/integrations": "workspace:*",
    "@ops-hub/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  }
}
